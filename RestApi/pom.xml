<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.werkpages</groupId>
		<artifactId>WerkpagesBackend</artifactId>
		<version>1.0-SNAPSHOT</version>
	</parent>

	<artifactId>RestApi</artifactId>

	<properties>
		<!--
			The Docker socket Testcontainers talks to.

			CLAUDE.md section 29 requires DOCKER_HOST in the Failsafe block and it still is there -
			this moves only the VALUE into a property so it can be overridden. The default is the
			development machine's Docker Desktop socket, so a local `mvn verify` is unchanged.

			A GitHub runner's daemon listens on /var/run/docker.sock, and the hardcoded Desktop
			path made these integration tests unrunnable in CI - part of why this repository had no
			workflow at all.

			    mvn verify -Ddocker.host=unix:///var/run/docker.sock
		-->
		<docker.host>unix:///home/noragrats/.docker/desktop/docker.sock</docker.host>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>2.25.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>secretsmanager</artifactId>
		</dependency>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>sts</artifactId>
		</dependency>
		<!-- Vert.x Core -->
		<dependency>
			<groupId>io.vertx</groupId>
			<artifactId>vertx-core</artifactId>
			<version>${vertx.version}</version>
		</dependency>

		<!-- Vert.x Web -->
		<dependency>
			<groupId>io.vertx</groupId>
			<artifactId>vertx-web</artifactId>
			<version>${vertx.version}</version>
		</dependency>

		<!-- Vert.x Web API Contract (for OpenAPI integration later) -->
		<dependency>
			<groupId>io.vertx</groupId>
			<artifactId>vertx-web-api-contract</artifactId>
			<version>${vertx.version}</version>
		</dependency>
		<dependency>
			<groupId>io.vertx</groupId>
			<artifactId>vertx-sql-client</artifactId>
			<version>${vertx.version}</version>
		</dependency>
		<dependency>
			<groupId>io.vertx</groupId>
			<artifactId>vertx-pg-client</artifactId>
			<version>${vertx.version}</version> <!-- Use the latest version -->
		</dependency>
		<dependency>
			<groupId>io.vertx</groupId>
			<artifactId>vertx-web-client</artifactId>
			<version>${vertx.version}</version> <!-- Use the latest version -->
		</dependency>

		<!-- Apache Commons IO (required for OpenAPI3RouterFactory) -->
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.18.0</version>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.6.0</version>
		</dependency>
		<!-- Jackson Datatype for Java 8 Date/Time API -->
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
			<version>2.19.1</version>
		</dependency>

		<!-- Jackson Core + Databind -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.19.1</version>
		</dependency>

		<!-- Swagger Core for OpenAPI 3 -->
		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-core</artifactId>
			<version>2.2.3</version>
		</dependency>

		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-models</artifactId>
			<version>2.2.3</version>
		</dependency>

		<!-- Swagger UI Webjar -->
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>swagger-ui</artifactId>
			<version>${swagger.version}</version>
		</dependency>
		<!-- Source: https://mvnrepository.com/artifact/com.ongres.scram/client -->
		<dependency>
			<groupId>com.ongres.scram</groupId>
			<artifactId>client</artifactId>
			<version>2.1</version>
			<scope>compile</scope>
		</dependency>
		<!-- Source: https://mvnrepository.com/artifact/org.flywaydb/flyway-core -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
			<version>12.0.0</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<version>12.0.0</version>
		</dependency>
		<dependency>
			<groupId>io.vertx</groupId>
			<artifactId>vertx-auth-jwt</artifactId>
			<version>${vertx.version}</version>
		</dependency>
		<dependency>
			<groupId>org.werkpages</groupId>
			<artifactId>Api</artifactId>
			<version>1.0-SNAPSHOT</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.10.2</version>
			<scope>test</scope>
		</dependency>

		<!--
			Testcontainers, test scope, for ONE suite: SessionLifecycleIntegrationTest.

			The Api module has had these for a long time; this module had neither them nor Failsafe,
			which is why authentication could be proven against a real Postgres (the repository) and
			over real HTTP (the handler) but never both at once. The security handler lives here and the
			database lives there, and Api cannot depend on RestApi, so the only place a test can hold
			both is this module.

			Versions match Api/pom.xml exactly - 1.20.4 - deliberately. Two Testcontainers versions in
			one build is a docker-java conflict waiting to happen, and the shaded client's api.version
			is pinned per module in the Failsafe configuration below.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>1.20.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<version>1.20.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Compiler Plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.10.1</version>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
				</configuration>
			</plugin>

			<!-- Unit tests (JUnit 5) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<!--
						Integration tests are Failsafe's, not surefire's.

						Without this, surefire picks up **/*IntegrationTest.java and runs it in the
						UNIT phase - where DOCKER_HOST is not set, because that variable lives in
						the Failsafe configuration below. The symptom is "Could not find a valid
						Docker environment" on three suites that pass perfectly well when Failsafe
						runs them, which is a confusing way to learn that two plugins were both
						claiming the same files. Api/pom.xml has had this exclusion for a long time.
					-->
					<excludes>
						<exclude>**/*IntegrationTest.java</exclude>
					</excludes>
					<environmentVariables>
						<!--
							AppEnv.current() is deliberately fatal when APP_ENV is unset: it decides
							CORS, the auth cookie's Secure flag, database TLS, HSTS and whether
							Swagger is published, so there is no safe default and the process
							refuses to boot without it.

							AuthCallbackHttpTest drives the real social callback, which reads it.
							Declared here rather than left to the developer's shell so the test
							behaves the same locally and in CI; 'development' is what makes the
							assertions about the dev origin and the cookie's absent Secure flag
							mean anything. NO version is changed by this block.
						-->
						<APP_ENV>development</APP_ENV>
					</environmentVariables>
				</configuration>
			</plugin>

			<!-- Shade Plugin for fat JAR -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.4.1</version>
				<executions>
					<execution>
						<id>shade-restapi</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<shadedArtifactAttached>true</shadedArtifactAttached>
							<shadedClassifierName>shaded</shadedClassifierName>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<filters>
								<!--
								  duckdb_jdbc is not a driver in the usual sense: it embeds the
								  whole DuckDB engine as a native library, and ships one for every
								  platform so a single jar runs anywhere. Only 43 of its entries
								  are class files; 246MB of it is native code.

								  The container is eclipse-temurin:21-jre-jammy built on a
								  GitHub-hosted runner, so it is linux/amd64. The other three
								  binaries can never load there and are pure weight in the image:

								    libduckdb_java.so_osx_universal    103.6 MB
								    libduckdb_java.so_linux_arm64       51.1 MB
								    libduckdb_java.so_windows_amd64     33.5 MB

								  Dropping them removes ~188MB uncompressed from the fat jar,
								  leaving the 58.0MB linux/amd64 engine that actually runs.

								  Sizes are for duckdb_jdbc 1.5.5.0. The four entry NAMES have
								  not changed since 1.3.1.0, which is what this filter matches
								  on - check them on any future upgrade, because a rename here
								  fails silently by shipping 188MB of unusable native code.

								  IF THE DEPLOY TARGET EVER MOVES TO ARM - a Graviton instance,
								  or a multi-arch image - keep linux_arm64 instead, or the
								  container will start and then fail on the first location query
								  with an UnsatisfiedLinkError. Local development is unaffected:
								  Eclipse and `mvn test` use the unshaded dependency.
								-->
								<filter>
									<artifact>org.duckdb:duckdb_jdbc</artifact>
									<excludes>
										<exclude>libduckdb_java.so_osx_universal</exclude>
										<exclude>libduckdb_java.so_linux_arm64</exclude>
										<exclude>libduckdb_java.so_windows_amd64</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<!-- Merge all META-INF/services files so Flyway
								discovers PostgreSQL -->
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<!-- Set the main class -->
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>
										org.werkpages.rest.MainVerticle</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>


			<!-- Optional: OpenAPI Generator Maven Plugin -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi.generator.version}</version>
			</plugin>
			<!--
				Integration tests, verify phase. Mirrors Api/pom.xml.

				The three settings below are NOT interchangeable with other configuration mechanisms,
				and CLAUDE.md section 29 records why:

				  * api.version MUST be a Java system property. The shaded docker-java client reads it
				    from system properties only, never from the environment.
				  * TESTCONTAINERS_RYUK_DISABLED MUST be an environment variable. The forked JVM does
				    not inherit it correctly from ~/.testcontainers.properties in this setup.
				  * DOCKER_HOST points at Docker Desktop's socket for this machine.

				No argLine here: unlike Api this module has no JaCoCo prepare-agent-integration
				execution, and @{argLine} with nothing to expand it fails the build.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<includes>
						<include>**/*IntegrationTest.java</include>
					</includes>
					<environmentVariables>
						<DOCKER_HOST>${docker.host}</DOCKER_HOST>
						<TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
						<!--
							Session ISSUANCE, on for integration tests only, for the same reason
							ROLE_AWARE_SUBMISSION_ENABLED is set in Api: a flag read from the environment
							cannot be set from inside a JVM that is already running. Off everywhere else.
						-->
						<APP_SESSIONS_ENABLED>true</APP_SESSIONS_ENABLED>
						<!--
							APP_ENV, for FAILSAFE as well as surefire.

							It was declared in the surefire block only, so integration tests ran
							without it. AppEnv.current() is deliberately fatal when it is unset, so
							any integration test that reaches Database.init - the migration
							fail-fast regression test does - died on the missing variable rather
							than on the behaviour it was asserting.

							'development' matches the surefire block, and keeps database TLS off
							against the Testcontainers Postgres, which does not serve TLS.

							NO version is changed by this block.
						-->
						<APP_ENV>development</APP_ENV>
					</environmentVariables>
					<systemPropertyVariables>
						<api.version>1.44</api.version>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
